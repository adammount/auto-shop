DATABASE_URI=postgres://postgres:postgres@localhost:5435/auto_shop
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Пароль БД для docker-compose (postgres-сервис и строка подключения web)
POSTGRES_PASSWORD=change-me-strong-db-password

# Учётная запись администратора (создаётся при seed)
ADMIN_EMAIL=admin@detal.ru
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Администратор

RESEND_API_KEY=
ORDER_EMAIL_TO=zakaz@detal.ru
ORDER_EMAIL_FROM=noreply@detal.ru

# Cloudflare Turnstile (капча в чекауте).
# Ниже — публичные тестовые ключи Cloudflare (всегда проходят), для прода замените на боевые.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
